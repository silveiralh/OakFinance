{
  "name": "@oakfinance/web",
  "version": "0.0.0",
  "private": true,
  "description": "PWA do OakFinance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-icons.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "build:e2e": "node scripts/build-icons.mjs && node scripts/build-e2e.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "e2e": "pnpm run build:e2e && playwright test",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@oakfinance/domain": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "barcode-detector": "3.2.3",
    "dexie": "4.4.7",
    "lucide-react": "1.70.0",
    "papaparse": "5.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uuid": "14.0.3",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "msw": "3.0.4",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1"
  }
