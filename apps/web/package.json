{
  "name": "@oakfinance/web",
  "version": "0.0.0",
  "private": true,
  "description": "PWA do OakFinance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-icons.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "build:e2e": "node scripts/build-icons.mjs && VITE_E2E=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "e2e": "pnpm run build:e2e && playwright test",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@oakfinance/domain": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "msw": "3.0.3",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
