{
  "name": "oakfinance",
  "version": "0.0.0",
  "private": true,
  "description": "PWA de finanças pessoais offline-first",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @oakfinance/web dev",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck && deno check scripts/mock-pluggy.ts",
    "test": "pnpm -r test && vitest run",
    "build": "pnpm --filter @oakfinance/web build",
    "e2e": "pnpm --filter @oakfinance/web e2e",
    "vendor": "node scripts/vendor-shared.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm vendor --check && pnpm test && pnpm build",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "vitest": "5.1.0"
  }
}
