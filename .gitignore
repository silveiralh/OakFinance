# Arquivos reais dos usuários nunca entram no repositório (só fixtures anonimizadas)
*.ofx
!**/fixtures/**/*.ofx

# Sistema e editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json

