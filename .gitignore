# Dependências e saídas de build
node_modules/
dist/
build/
coverage/
reports/
*.tsbuildinfo
.vite/
.stryker-tmp/

# Testes E2E
playwright-report/
test-results/
blob-report/
e2e-results.json

# Supabase local
supabase/.temp/
supabase/.branches/

# Variáveis de ambiente: nunca versionar (repositório público)
.env
.env.*
*.env
!.env.example
