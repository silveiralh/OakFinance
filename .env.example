# Variáveis públicas do build do app web (tech §9.8).
# Só nomes: os valores de produção e staging ficam nas GitHub variables (SETUP-09).
# Para desenvolvimento local, copie para apps/web/.env.local (ignorado pelo git)
# e preencha com os valores impressos por `supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_APP_ENV=local
